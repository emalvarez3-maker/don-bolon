<?xml version="1.0" encoding="utf-8"?>
<!-- Only encrypted traffic: the app talks to the AI providers over HTTPS and nothing else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
